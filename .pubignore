# pub reads this file instead of .gitignore, so the .gitignore entries are repeated here.

# The author's private wiki (an Obsidian vault).
/wiki/

# Claude Code instructions, at any level.
CLAUDE.md

# Miscellaneous
*.log
*.swp
.DS_Store

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Dart/Pub related
.dart_tool/
pubspec.lock
/doc/api/
/coverage/

# CI plumbing.
.github/

# Consumers get the package, not our test suite: pana awards nothing for shipping
# tests. Root-anchored on purpose.
/test/

# End-to-end fixtures: Flutter apps, a test plugin and its stub. Root-anchored.
/e2e/

# Lints for developing this package; consumers don't have its dev dependency
# package:lints, and pana analyzes with its own options.
/analysis_options.yaml
